{
  "name": "@windower/cli",
  "version": "0.1.1",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "windower": "./dist/index.js"
  },
  "files": ["dist", "README.md"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build && chmod +x dist/index.js",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --build --emitDeclarationOnly false --noEmit",
    "clean": "tsc --build --clean"
  },
  "dependencies": {
    "@windower/core": "workspace:*",
    "@windower/daemon": "workspace:*",
    "@windower/engine": "workspace:*",
    "@windower/operator": "workspace:*",
    "commander": "^12.1.0"
  },
  "optionalDependencies": {
    "@windower/sidecar-macos-arm64": "workspace:*",
    "@windower/sidecar-macos-x64": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
