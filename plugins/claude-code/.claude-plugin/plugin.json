{
  "name": "windower",
  "version": "0.0.0",
  "description": "AI-native screen recorder: enumerate targets, size a window, record a demo, narrate, and get back a video + manifest — driven by the windower CLI/MCP server.",
  "author": {
    "name": "Windower"
  },
  "mcpServers": {
    "windower": {
      "command": "node",
      "args": [
        "/Users/edicury/Documents/Development/windower/packages/mcp-server/dist/index.js"
      ],
      "env": {
        "WINDOWER_SIDECAR_BINARY_PATH": "/Users/edicury/Documents/Development/windower/native/macos/.build/arm64-apple-macosx/debug/windower-capture-macos"
      }
    }
  }
}
